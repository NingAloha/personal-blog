{
  "name": "personal-blog-cloudflare",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:frontend": "npm run build:frontend:preview",
    "build:frontend:preview": "npm --prefix ../frontend run build:cloudflare:preview",
    "build:frontend:production": "npm --prefix ../frontend run build:cloudflare:production",
    "dev": "npm run build:frontend && wrangler dev --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply CONTENT_DB --local --persist-to .wrangler/state",
    "content:validate": "node scripts/import-content.mjs --dry-run",
    "content:import:local": "node scripts/import-content.mjs --local --persist-to .wrangler/state",
    "test": "node --test",
    "check": "npm run build:frontend && wrangler deploy --dry-run --env=\"\" --outdir .wrangler/dry-run",
    "deploy:preview": "npm run build:frontend:preview && wrangler deploy --env preview",
    "deploy:production": "npm run build:frontend:production && wrangler deploy --env production"
  },
  "dependencies": {
    "@11ty/gray-matter": "^3.0.0",
    "markdown-it": "^14.1.1"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
